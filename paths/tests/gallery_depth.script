# Front red box is drawn before a blue box behind it. The middle pixel must
# stay red, and a cursor pick there must select object 2, regardless of order.
frame
select 1
patrol 0
position -5 2 -5
select 3
patrol 0
position 5 2 -5
select 2
position 0 2 -1
size 3 3 1
color 1 0 0
add_box
position 0 2 -4
size 3 3 1
color 0 0 1
select 0
frame
pick 0.5 0.5
