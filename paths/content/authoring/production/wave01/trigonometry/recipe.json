  "domain": {
    "units": "radians",
    "lower": "0",
    "upper": "2",
    "include_lower": true,
    "include_upper": false
  },
  "roles": [
    {
      "role": "read_notation",
      "title": "Read the target coordinate",
      "objective": "Interpret the exact coordinate required by the original equation.",
      "prerequisites": "Radian angles, interval inequalities, signed arithmetic, and unit-circle coordinates."
    },
    {
      "role": "worked_check",
      "title": "Complete the other one-turn point",
      "objective": "Supply the other permitted angle with the stated coordinate.",
      "prerequisites": "Radian angles, interval inequalities, signed arithmetic, and unit-circle coordinates."
    },
    {
      "role": "choose_next_step",
      "title": "Isolate the coordinate",
      "objective": "Choose an equivalent equation with the trigonometric coordinate isolated.",
      "prerequisites": "Radian angles, interval inequalities, signed arithmetic, and unit-circle coordinates."
    },
    {
      "role": "explain_step",
      "title": "Explain the matching coordinate",
      "objective": "Choose the reflection that preserves the stated coordinate.",
      "prerequisites": "Radian angles, interval inequalities, signed arithmetic, and unit-circle coordinates."
    },
    {
      "role": "repair_error",
      "title": "Repair the first endpoint error",
      "objective": "Identify the first interval error and repair the complete set.",
      "prerequisites": "Radian angles, interval inequalities, signed arithmetic, and unit-circle coordinates."
    },
    {
      "role": "independent",
      "title": "Solve a fresh one-turn equation",
      "objective": "Select every solution of a new equation in the stated interval.",
      "prerequisites": "Radian angles, interval inequalities, signed arithmetic, and unit-circle coordinates."
    }
  ],
